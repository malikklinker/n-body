# Hidden files and directories, except this ignore file.
.*
!.gitignore

# Python bytecode caches.
__pycache__/
*.py[cod]

# Build directories.
build/
bin/
obj/

# Compiled objects and compiler-generated dependencies.
*.o
*.obj
*.d
*.gch
*.pch

# Libraries and executables.
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out

# Debug symbols.
*.pdb
*.dSYM/
